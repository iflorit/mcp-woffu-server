# Woffu MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Your Woffu JWT Bearer token
# Get this from browser dev tools when logged into Woffu
WOFFU_TOKEN=your-jwt-token-here

# Required: Your Woffu user ID
# Find this in API requests or your Woffu profile
WOFFU_USER_ID=1234567

# Optional: Your Woffu instance URL
# Default: https://app.woffu.com
WOFFU_BASE_URL=https://yourcompany.woffu.com
